FROM mcr.microsoft.com/devcontainers/python:3.11

# Packages installation (eg git-lfs)
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends curl git-lfs ffmpeg make bash-completion \
    && rm -rf /var/cache/apt && \
    apt-get clean

#    libsm6 libxext6 graphviz libgraphviz-dev xdg-utils swig gringo gobject-introspection libcairo2-dev libgirepository1.0-dev pkg-config python3-dev python3-gi

# Install uv for modern Python package management
COPY --from=ghcr.io/astral-sh/uv:latest --chown=vscode: /uv /uvx /bin/

# We respect the existing package versions
RUN mkdir -p /etc/pip
RUN pip list --format=freeze > /etc/pip/constraint.txt

# Install PyTorch CPU version using uv
RUN uv pip install --system --constraint /etc/pip/constraint.txt torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

USER vscode